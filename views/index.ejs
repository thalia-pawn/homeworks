<!DOCTYPE html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <main class="container">
      <header class="page-header">
        <h1>Список книг</h1>
        <a class="button" href="/books/create">Добавить книгу</a>
        <a class="button" href="/user/me">Личный кабинет</a>
      </header>

      <% if (books.length === 0) { %>
      <section class="card">
        <p>Книги пока не добавлены.</p>
      </section>
      <% } else { %>
      <section class="card">
        <ul class="book-list">
          <% books.forEach((book) => { %>
          <li>
            <a href="/books/<%= book.id %>"><%= book.title %></a>
          </li>
          <% }) %>
        </ul>
      </section>
      <% } %>
    </main>
  </body>
</html>
