<!DOCTYPE html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <link rel="stylesheet" href="/styles.css" />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap@4.5.3/dist/css/bootstrap.min.css"
      integrity="sha384-TX8t27EcRE3e/ihU7zmQxVncDAy5uIKz4rEkgIXeMed4M0jlfIDPvg6uqKI2xXr2"
      crossorigin="anonymous"
    />
    <script src="/socket.io/socket.io.js"></script>
  </head>
  <body>
    <main class="container">
      <nav class="actions">
        <form action="/books/<%= book.id %>/delete" method="post" class="inline-form">
          <button type="submit" class="button button-danger">Удалить книгу</button>
        </form>
        <a class="button button-secondary" href="/books">← К списку</a>
        <a class="button" href="/books/<%= book.id %>/update">Редактировать</a>
      </nav>

      <section class="card book-view">
        <div>
          <h1><%= book.title %></h1>
          <dl class="book-meta">
            <dt>ID</dt>
            <dd><%= book.id %></dd>

            <dt>Описание</dt>
            <dd><%= book.description %></dd>

            <dt>Авторы</dt>
            <dd><%= book.authors %></dd>

            <dt>Избранное</dt>
            <dd><%= book.favorite %></dd>

            <dt>Обложка</dt>
            <dd><%= book.fileCover %></dd>

            <dt>Имя файла</dt>
            <dd><%= book.fileName %></dd>

            <dt>Идентификатор файла</dt>
            <dd><%= book.fileBook %></dd>

            <dt>Количество просмотров</dt>
            <dd><%= book.countOfViews %></dd>
          </dl>
        </div>
      </section>

      <form action="/books/<%= book.id %>/comments/add" method="post" class="form-grid">
        <label>
          Оставьте комментарий
          <input
            type="text"
            id="text"
            name="text"
            value=""
            placeholder="Комментарий"
            required
          />
        </label>
        <button type="submit" class="button" id="sendButton">
          Оставить комментарий
        </button>
      </form>

      <section class="card">
        <% if (comments.length === 0) { %>
          <p id="emptyComments">Комментариев пока нет</p>
        <% } %>

        <ul class="book-comments" id="commentsList">
          <% comments.forEach((comment) => { %>
            <li>
              <dt><%= comment.login %></dt>
              <dd><%= comment.text %></dd>
            </li>
          <% }) %>
        </ul>
      </section>

      <script>
        const bookId = '<%= book.id %>';
        const socket = io('/', {
          query: { bookId }
        });

        const commentsList = document.getElementById('commentsList');

        const escapeHtml = (value) => {
          const div = document.createElement('div');
          div.textContent = value;
          return div.innerHTML;
        };

        const getTmp = (msg) => {
          return `
            <li>
              <dt>${escapeHtml(msg.login)}</dt>
              <dd>${escapeHtml(msg.text)}</dd>
            </li>
          `;
        };

        socket.on('new_comment', (msg) => {
          const emptyComments = document.getElementById('emptyComments');

          if (emptyComments) {
            emptyComments.remove();
          }

          commentsList.insertAdjacentHTML('beforeend', getTmp(msg));
        });
      </script>
    </main>
  </body>
</html>