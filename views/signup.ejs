<!DOCTYPE html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <main class="container">
      <nav class="actions">
        <a class="button button-secondary" href="/user/login">← Вернуться на страницу входа</a>
      </nav>

      <section class="card">
        <h1>Укажите следующие данные</h1>

        <form action="/user/signup" method="post" class="form-grid">
          <label>
            Логин
            <input type="text" name="login" value="" required />
          </label>

          <label>
            Пароль
            <input type="text" name="password" value="" required />
          </label>

          <label>
            Почта
            <input type="text" name="email" value="" required />
          </label>

          <button type="submit" class="button">Зарегистрироваться</button>
        </form>
      </section>
    </main>
  </body>
</html>
